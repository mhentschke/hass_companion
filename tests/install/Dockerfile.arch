FROM archlinux:latest

ENV PATH="/root/.local/bin:${PATH}"

RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm python-pipx && \
    pacman -Scc --noconfirm

WORKDIR /app
COPY . .

RUN pipx install .

# Verify CLI entry point works
RUN hass-companion --version
RUN hass-companion --validate --config /app/tests/install/config.yaml
