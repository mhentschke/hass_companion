FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y python3-pip python3-venv pipx && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN pipx install .

# Verify CLI entry point works
RUN hass-companion --version

# Validate with an inline minimal config
RUN printf 'mqtt:\n  host: localhost\n  port: 1883\nhass:\n  device_name: Test\n  device_id: test\n' > /tmp/test-config.yaml && \
    hass-companion --validate --config /tmp/test-config.yaml
