FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y python3-pip python3-venv pipx && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

RUN pipx install .

# Verify CLI entry point works
RUN hass-companion --version
RUN hass-companion --validate --config tests/install/config.yaml
