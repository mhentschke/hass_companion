FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    systemd systemd-sysv dbus \
    mosquitto-clients \
    && rm -rf /var/lib/apt/lists/*

# Remove unnecessary systemd units that cause noise in containers
RUN rm -f /lib/systemd/system/multi-user.target.wants/* \
    /etc/systemd/system/*.wants/* \
    /lib/systemd/system/local-fs.target.wants/* \
    /lib/systemd/system/sockets.target.wants/*udev* \
    /lib/systemd/system/sockets.target.wants/*initctl* \
    /lib/systemd/system/sysinit.target.wants/systemd-tmpfiles-setup* \
    /lib/systemd/system/systemd-update-utmp*

# Copy project
WORKDIR /app
COPY . /app/

# Install hass-companion in a venv
RUN python3 -m venv /opt/hass-companion && \
    /opt/hass-companion/bin/pip install --upgrade pip && \
    /opt/hass-companion/bin/pip install .

# Make binary accessible system-wide
RUN ln -s /opt/hass-companion/bin/hass-companion /usr/local/bin/hass-companion

# Copy test config and env
RUN mkdir -p /etc/hass-companion
COPY tests/service-install/test-config.yaml /etc/hass-companion/config.yaml
RUN printf 'HA_MQTT_HOST=mosquitto\nHA_MQTT_PORT=1883\n' > /etc/hass-companion/.env

# Copy test script
COPY tests/service-install/test-service.sh /test-service.sh
RUN chmod +x /test-service.sh

STOPSIGNAL SIGRTMIN+3
VOLUME ["/sys/fs/cgroup"]

# Boot into systemd
CMD ["/lib/systemd/systemd"]
